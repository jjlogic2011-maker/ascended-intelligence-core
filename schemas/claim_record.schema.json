{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimRecord",
  "type": "object",
  "required": [
    "claim_id",
    "claim_text",
    "status",
    "confidence"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim_text": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "enum": [
        "observed",
        "claimed",
        "verified",
        "proven",
        "disputed",
        "speculative",
        "interpretation",
        "spiritual_evaluation",
        "revoked"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_date": {
      "type": "string"
    },
    "public_safe_wording": {
      "type": "string"
    }
  }
}